{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "permissions": [
    "core:default",
    {
      "identifier": "opener:allow-open-url",
      "allow": [{ "url": "https://*.stripe.com/*" }, { "url": "mailto:info@momentumminds.net" }]
    },
    {
      "identifier": "http:default",
      "allow": [
        { "url": "https://api.focusbox.net/*" },
        { "url": "http://localhost:8000/*" }
      ]
    },
    "updater:default",
    "autostart:default",
    "process:default",
    "window-state:default",
    "core:window:allow-show",
    "core:window:allow-unminimize",
    "core:window:allow-set-focus",
    "allow-spotify-control",
    "allow-spotify-state",
    "allow-app-store-read",
    "allow-app-store-write",
    "allow-guard-supported",
    "allow-guard-set-config",
    "allow-guard-log-newtask",
    "allow-guard-stats",
    "allow-guard-preview-nudge",
    "allow-todoist-status",
    "allow-todoist-set-token",
    "allow-todoist-clear-token",
    "allow-park"
  ],
  "windows": ["main"]
}
